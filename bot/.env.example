# Proposal Bot — copy to .env or set in the shell / compose.
# Shared secret: Hub sends this as X-API-Key to POST /generate. Must match Hub BOT_API_KEY.
BOT_API_KEY=change-me-to-a-long-random-string
PORT=9000
# Hub the bot reads categories/projects from (X-API-Key = Hub API_KEY).
HUB_URL=http://localhost:8000
HUB_API_KEY=
# OpenAI generation. Without OPENAI_API_KEY the bot uses documented stub
# mode: a deterministic template over the same Hub-selected live projects
# (no invented claims). OPENAI_MODEL defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
