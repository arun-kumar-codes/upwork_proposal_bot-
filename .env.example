# Copy to .env and fill in. Backend reads this from the repo root.
DATABASE_URL=sqlite:///./projecthub.db
# For Postgres (docker-compose sets this automatically):
# DATABASE_URL=postgresql+psycopg://hub:hub@db:5432/hub

# API key the Upwork proposal bot sends as X-API-Key (also used by the dashboard).
API_KEY=change-me-to-a-long-random-string

# Dashboard admin login (single user).
ADMIN_PASSWORD=change-me-too

# Optional: raises GitHub API rate limits for "Add from GitHub URL".
GITHUB_TOKEN=

# Test Playground: Simulated mode needs an LLM key (OpenAI-compatible);
# Real Bot mode POSTs to BOT_URL/generate (stays disabled until set).
OPENAI_API_KEY=
# Accepted aliases (OpenAI-compatible providers): either naming works.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
BOT_URL=
# Shared secret Hub sends as X-API-Key to BOT_URL/generate (must match bot BOT_API_KEY).
BOT_API_KEY=

# Frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
